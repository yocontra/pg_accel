# pg_accel production image: PostGIS + H3 + pg_accel on PostgreSQL 17
# Multi-stage build — no build tools in the final image.

# ============================================================
# Stage 1: Build pg_accel extension from source
# ============================================================
FROM postgres:17-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    cmake \
    git \
    pkg-config \
    libssl-dev \
    libclang-dev \
    clang \
    llvm-dev \
    postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install cargo-pgrx
RUN cargo install cargo-pgrx@0.17.0 --locked

# Initialize pgrx with system pg_config
RUN cargo pgrx init --pg17 "$(which pg_config)"

# Copy workspace source
COPY Cargo.toml Cargo.lock /build/
COPY pg_accel/ /build/pg_accel/
COPY pg_accel_bench/ /build/pg_accel_bench/

WORKDIR /build

# Build the extension (CPU-fallback only — no GPU in Docker)
RUN cargo pgrx package \
    --package pg_accel \
    --pg-config "$(which pg_config)" \
    --no-default-features \
    --features pg17

# ============================================================
# Stage 2: Build h3 C library + h3-pg extension
# ============================================================
FROM postgres:17-bookworm AS h3-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    build-essential \
    cmake \
    git \
    postgresql-server-dev-17 \
    && rm -rf /var/lib/apt/lists/*

# Build h3 C library v4.2.1
RUN git clone --branch v4.2.1 --depth 1 https://github.com/uber/h3.git /tmp/h3 \
    && cd /tmp/h3 \
    && cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && cmake --build build --target install \
    && rm -rf /tmp/h3

# Build h3-pg extension
RUN git clone --depth 1 https://github.com/zachasme/h3-pg.git /tmp/h3-pg \
    && cd /tmp/h3-pg \
    && make \
    && make install \
    && rm -rf /tmp/h3-pg

# ============================================================
# Stage 3: Final production image
# ============================================================
FROM postgres:17-bookworm

LABEL maintainer="Eric Schoffstall"
LABEL description="PostgreSQL 17 with PostGIS, H3, and pg_accel (GPU-accelerated query processing)"

# Install PostGIS and runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    postgresql-17-postgis-3 \
    postgresql-17-postgis-3-scripts \
    && rm -rf /var/lib/apt/lists/*

# Copy h3 shared libraries from h3-builder
COPY --from=h3-builder /usr/local/lib/libh3.* /usr/local/lib/
RUN ldconfig

# Copy h3-pg extension files from h3-builder
COPY --from=h3-builder /usr/share/postgresql/17/extension/h3* /usr/share/postgresql/17/extension/
COPY --from=h3-builder /usr/lib/postgresql/17/lib/h3* /usr/lib/postgresql/17/lib/

# Copy pg_accel extension from builder
COPY --from=builder /build/target/release/pg_accel-pg17/usr/ /usr/

# Configure shared_preload_libraries
RUN echo "shared_preload_libraries = 'pg_accel'" >> /usr/share/postgresql/postgresql.conf.sample

# Init script: create extensions on first startup
RUN mkdir -p /docker-entrypoint-initdb.d \
    && printf '#!/bin/bash\nset -e\npsql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-EOSQL\n\tCREATE EXTENSION IF NOT EXISTS postgis;\n\tCREATE EXTENSION IF NOT EXISTS h3;\n\tCREATE EXTENSION IF NOT EXISTS pg_accel;\nEOSQL\n' \
    > /docker-entrypoint-initdb.d/01-create-extensions.sh \
    && chmod +x /docker-entrypoint-initdb.d/01-create-extensions.sh

EXPOSE 5432

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD pg_isready -U postgres || exit 1
