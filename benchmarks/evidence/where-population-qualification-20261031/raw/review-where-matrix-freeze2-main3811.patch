+            let c = contract(name).expect("exact contract");
+            let oid = match c.key {
+                Key::Int2 => 21,
+                Key::Int4 => 23,
+                Key::Int8 => 20,
+                Key::H3 => 16400,
+            };
+            let key = if c.key == Key::H3 {
+                format!(
