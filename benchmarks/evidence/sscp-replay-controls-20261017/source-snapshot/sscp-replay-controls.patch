+// Explicit IDs are an opt-in replay input, not a cross-object uniqueness policy.
+// LLVM 20 tracks occurrences but does not enforce Optional during parsing.
+class HcfObjectIdParser : public llvm::cl::parser<unsigned long long> {
+public:
+  explicit HcfObjectIdParser(llvm::cl::Option &O) : parser(O) {}
+
+  bool parse(llvm::cl::Option &O, llvm::StringRef, llvm::StringRef Arg,
+             unsigned long long &Value) {
+    if(O.getNumOccurrences() > 1)
+      return O.error("explicit HCF ID may only occur once");
+    if(std::numeric_limits<std::size_t>::digits != 64)
+      return O.error("explicit HCF IDs require a 64-bit compiler host");
+    constexpr unsigned long long Max = 18446744073709551615ULL;
+    if(Arg.empty() || Arg.front() < '1' || Arg.front() > '9')
+      return O.error("expected canonical decimal ID in 1..18446744073709551615");
+    unsigned long long Parsed = 0;
+    for(char C : Arg) {
+      if(C < '0' || C > '9' || Parsed > (Max - (C - '0')) / 10)
+        return O.error("expected canonical decimal ID in 1..18446744073709551615");
+      Parsed = Parsed * 10 + (C - '0');
+    }
+    Value = Parsed;
+    return false;
+  }
+};
+
+static llvm::cl::opt<unsigned long long, false, HcfObjectIdParser> SSCPHcfObjectId{
+    "acpp-sscp-hcf-object-id", llvm::cl::Optional, llvm::cl::ValueRequired,
+    llvm::cl::desc{"Explicit unique per-object HCF ID for exact compilation replay"}};
 
