+        #[pg_test]
+        fn live_resident_estimate_keeps_catalog_and_invalidation_guards() {
+            use super::super::{SelectedRelation, estimate_selected_relation};
+
+            cleanup_backend();
+            Spi::run("CREATE TEMP TABLE pgaccel_lazy_estimate (value int4)")
+                .expect("estimate fixture creation");
+            let relid = test_relation_oid("pgaccel_lazy_estimate");
+            let count_request = SelectedRelation {
+                relid,
+                columns: vec![],
+            };
+            assert!(
+                !estimate_selected_relation(&count_request)
+                    .expect("cold count")
+                    .loaded
+            );
+            install_catalog_backed_entry(relid);
+            assert!(
+                estimate_selected_relation(&count_request)
+                    .expect("exact warm count")
+                    .loaded
+            );
+            Spi::run("TRUNCATE pgaccel_lazy_estimate").expect("invalidate retained ownership");
+            assert!(
+                !estimate_selected_relation(&count_request)
+                    .expect("invalidated count")
+                    .loaded
+            );
+
+            let column_request = SelectedRelation {
+                relid,
+                columns: vec![1],
+            };
+            assert!(
+                !estimate_selected_relation(&column_request)
+                    .expect("supported column")
+                    .loaded
+            );
+            Spi::run(
+                "ALTER TABLE pgaccel_lazy_estimate ALTER COLUMN value TYPE jsonb USING NULL::jsonb",
+            )
+            .expect("unsupported type change");
+            assert!(estimate_selected_relation(&column_request).is_err());
+            Spi::run("ALTER TABLE pgaccel_lazy_estimate DROP COLUMN value")
+                .expect("drop requested attribute");
+            assert!(estimate_selected_relation(&column_request).is_err());
+            Spi::run("ALTER TABLE pgaccel_lazy_estimate ENABLE ROW LEVEL SECURITY")
+                .expect("enable RLS");
+            assert!(estimate_selected_relation(&count_request).is_err());
+            Spi::run("DROP TABLE pgaccel_lazy_estimate").expect("drop relation");
+            assert!(estimate_selected_relation(&count_request).is_err());
+            cleanup_backend();
+        }
