+    #[test]
+    fn planner_resident_byte_estimation_is_lazy_and_preserves_fallback_order() {
+        let request = SelectedRelation {
+            relid: pg_sys::Oid::from(1455_u32),
+            columns: vec![1],
+        };
+        let required = [ColumnRequest {
+            attno: 1,
+            type_oid: pg_sys::INT4OID,
+        }];
+        install_planner_evidence_relation(1455, 17);
+        let warm = estimate_resolved_selected_relation(&request, &required, true, || {
+            panic!("exact resident ownership must not invoke the catalog estimator")
+        })
+        .expect("exact warm estimate");
+        assert!(warm.loaded);
+        assert_eq!(warm.resident_rows, Some(17));
+        assert!(revalidate_loaded_estimates(
+            std::slice::from_ref(&request),
+            &[warm]
+        ));
+
+        for columns in [
+            vec![ColumnRequest {
+                attno: 1,
+                type_oid: pg_sys::INT8OID,
+            }],
+            vec![
+                required[0],
+                ColumnRequest {
+                    attno: 2,
+                    type_oid: pg_sys::INT4OID,
+                },
+            ],
+        ] {
+            let calls = Cell::new(0);
+            let partial = estimate_resolved_selected_relation(&request, &columns, true, || {
+                calls.set(calls.get() + 1);
+                Ok(91)
+            })
+            .expect("partial estimate");
+            assert_eq!(calls.get(), 1);
+            assert!(!partial.loaded);
+            assert_eq!(partial.estimated_bytes, 91);
+            let error = estimate_resolved_selected_relation(&request, &columns, true, || {
+                Err(ResidentLoadError::Loader(
+                    "sentinel estimate failure".into(),
+                ))
+            })
+            .expect_err("partial estimate error must propagate");
+            assert_eq!(
+                error,
+                ResidentLoadError::Loader("sentinel estimate failure".into())
+            );
+        }
+
+        STORE.with(|store| store.borrow_mut().remove_relation(request.relid));
+        let calls = Cell::new(0);
+        let cold = estimate_resolved_selected_relation(&request, &required, true, || {
+            calls.set(calls.get() + 1);
+            Ok(73)
+        })
+        .expect("cold estimate");
+        assert_eq!(calls.get(), 1);
+        assert!(!cold.loaded);
+        assert_eq!(cold.estimated_bytes, 73);
+        assert!(
+            estimate_resolved_selected_relation(&request, &required, true, || {
+                Err(ResidentLoadError::Loader("cold sentinel".into()))
+            })
+            .is_err()
+        );
+
+        let recaptured = estimate_resolved_selected_relation(&request, &required, true, || {
+            // A mutable borrow here proves the helper released its initial
+            // borrow before the callback; installation models SPI reentrancy.
+            install_planner_evidence_relation(1455, 29);
+            STORE.with(|store| {
+                let mut store = store.borrow_mut();
+                store.entries[0].load_ms = 12.5;
+                store.entries[0].raw_charge =
+                    LedgerCharge::reserve(123, u64::MAX).expect("test retained charge");
+                store.pins.insert(
+                    1455,
+                    PinSpec {
+                        columns: required.to_vec(),
+                    },
+                );
+            });
+            Ok(999)
+        })
+        .expect("post-estimator snapshot");
+        assert!(recaptured.loaded);
+        assert!(recaptured.pinned);
+        assert_eq!(recaptured.last_load_ms, Some(12.5));
+        assert_eq!(recaptured.resident_rows, Some(29));
+        assert_eq!(recaptured.estimated_bytes, 123);
+        assert!(revalidate_loaded_estimates(
+            std::slice::from_ref(&request),
+            &[recaptured]
+        ));
+        STORE.with(|store| {
+            store.borrow_mut().pins.remove(&1455);
+        });
+    }
