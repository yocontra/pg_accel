+/// Preserve catalog validation at the caller while avoiding a discarded byte
+/// estimate for exact resident ownership. No store borrow spans the estimator.
+fn estimate_resolved_selected_relation(
+    request: &SelectedRelation,
+    columns: &[ColumnRequest],
+    fixed_width: bool,
+    estimate_bytes: impl FnOnce() -> Result<u64, ResidentLoadError>,
+) -> Result<ResidentLoadEstimate, ResidentLoadError> {
+    let snapshot = || {
+        STORE.with(|store| {
+            let store = store.borrow();
+            let entry = store
+                .entries
+                .iter()
+                .find(|entry| entry.relid == request.relid);
+            // The resolved request includes pinned and already-loaded columns.
+            // Only complete coverage permits replacing a catalog estimate with the
+            // actual retained charge. A selected subset must not hide other owners.
+            let loaded_entry = entry.filter(|entry| covers_planner_column_union(entry, columns));
+            (
+                loaded_entry.map(|entry| {
+                    (
+                        ResidentDependencyStamp::from_relation(entry),
+                        entry.row_count,
+                        selected_columns_have_no_null_sidecars(entry, &request.columns)
+                            .expect("loaded entry covers every selected column"),
+                        entry.raw_bytes(),
+                        retained_column_identity(entry),
+                    )
+                }),
+                loaded_entry
+                    .and_then(|entry| selected_numeric_column_stats(entry, &request.columns)),
+                loaded_entry.and_then(|entry| selected_nullable_columns(entry, &request.columns)),
+                store.pins.contains_key(&u32::from(request.relid)),
+                entry.map(|entry| entry.load_ms),
+            )
+        })
+    };
+    let mut evidence = snapshot();
+    let estimated_bytes = if let Some(resident) = evidence.0.as_ref() {
+        // Actual retained ownership does not depend on catalog row estimates
+        // or their overflow checks. All structural validation still precedes
+        // this branch, and candidate currentness is independently revalidated.
+        resident.3
+    } else {
+        let estimated = estimate_bytes()?;
+        // SPI can process invalidations or reenter extension code. Preserve
+        // the original fallback ordering: capture ALL metadata after it runs.
+        evidence = snapshot();
+        evidence.0.as_ref().map_or(estimated, |resident| resident.3)
+    };
