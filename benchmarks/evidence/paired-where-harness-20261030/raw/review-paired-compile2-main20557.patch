+use super::*;
+#[cfg(feature = "pg_test")]
+#[derive(Clone)]
+pub(crate) struct PairedRecipe {
+    pub(crate) selection: crate::engine::executor::agg::AggExecutionSelection,
+    pub(crate) spec: crate::engine::spec::AggQuerySpec,
+    pub(crate) projection: AggOutputProjection,
+    pub(crate) cost_components: String,
+}
+
+#[cfg(feature = "pg_test")]
+thread_local! {
+    static PAIRED_RECIPES: std::cell::RefCell<Option<Vec<PairedRecipe>>> = const {
+        std::cell::RefCell::new(None)
+    };
+}
+
+#[cfg(feature = "pg_test")]
+pub(super) fn paired_capture_recipe(shape: &ShapePlan) {
+    if !PAIRED_RECIPES.with(|slot| slot.borrow().is_some()) { return; }
+    let recipe = PairedRecipe {
+        selection: shape.execution_selection(), spec: shape.spec.clone(),
+        projection: AggOutputProjection { slots: shape.projections.clone() },
+        cost_components: format!("{:?}", shape.cost),
+    };
+    PAIRED_RECIPES.with(|slot| {
+        slot.borrow_mut().as_mut().expect("active diagnostic").push(recipe);
+    });
+}
+
+#[cfg(feature = "pg_test")]
+pub(crate) fn capture_paired_recipes<T>(body: impl FnOnce() -> T)
+    -> Result<(T, [PairedRecipe; 2]), String>
+{
+    struct Restore(Option<Vec<PairedRecipe>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            PAIRED_RECIPES.with(|slot| *slot.borrow_mut() = self.0.take());
+        }
+    }
+    let _restore = Restore(PAIRED_RECIPES.with(|slot| slot.borrow_mut().replace(Vec::new())));
+    let value = body(); // guarded SPI EXPLAIN without ANALYZE; no TLS borrow held
+    let recipes = PAIRED_RECIPES.with(|slot| slot.borrow_mut().take())
+        .ok_or("diagnostic capture was unexpectedly cleared")?;
+    let [legacy, raw]: [PairedRecipe; 2] = recipes.try_into()
+        .map_err(|_| "need exactly two independently built candidates")?;
+    use crate::engine::executor::agg::AggExecutionSelection;
+    if legacy.selection != AggExecutionSelection::Legacy
+        || raw.selection != AggExecutionSelection::RawIntegerCount {
+        return Err("unexpected candidate order/selection".into());
+    }
+    Ok((value, [legacy, raw]))
+}
+
+// Exact hook site: immediately after apply_exact_residency returns Ok in
+// try_inject_candidate, before effective_path_cost/add_native_having_cost/gate.
+// Add `#[cfg(feature="pg_test")] paired_capture_recipe(&shape);`.
+// Re-export capture_paired_recipes/PairedRecipe from planner_hooks/mod.rs ONLY
+// under pg_test. Early cache hits intentionally yield missing recipes and stop
+// the diagnostic; do not clear caches or manufacture the missing candidate.
diff --git a/pg_accel/src/engine/residency/store/paired.rs b/pg_accel/src/engine/residency/store/paired.rs
new file mode 100644
index 00000000..4e6b6829
--- /dev/null
+++ b/pg_accel/src/engine/residency/store/paired.rs
@@ -0,0 +1,82 @@
+use super::*;
+#[cfg(feature = "pg_test")]
+pub(crate) fn paired_remove_exact_derived(
+    expected: ResidentRelationEvidence,
+    identity: &DerivedArtifactIdentity,
+) -> Result<u64, String> {
+    let owners = crate::engine::ffi::custom_scan::test_executor_cleanup_counts();
+    if owners.installed != owners.normal_end.checked_add(owners.query_reset)
+        .ok_or("cleanup count overflow")? {
+        return Err("targeted invalidation requires no installed executor".into());
+    }
+    if identity.canonical_words().is_empty() {
+        return Err("empty exact artifact identity".into());
+    }
+    process_invalidations();
+    STORE.with(|slot| {
+        // Fail closed if any active residency lease exists, even if it was not
+        // created through a CustomScan. No PG service occurs under this borrow.
+        let mut store = slot.try_borrow_mut().map_err(|_| "active residency lease")?;
+        let entry = store.entries.iter_mut().find(|entry| entry.relid == expected.relid)
+            .ok_or("raw owner is no longer resident")?;
+        let current = entry.evidence();
+        if (current.generation, current.global_generation, current.relfilenode,
+            current.row_count, current.raw_bytes, current.raw_accounting) !=
+           (expected.generation, expected.global_generation, expected.relfilenode,
+            expected.row_count, expected.raw_bytes, expected.raw_accounting) {
+            return Err("raw generation or exact footprint changed".into());
+        }
+        let matches = entry.derived.iter().enumerate()
+            .filter_map(|(index, derived)| derived.has_identity(identity).then_some(index))
+            .collect::<Vec<_>>();
+        let [index] = matches.as_slice() else {
+            return Err("fresh phase requires exactly one known cached artifact".into());
+        };
+        let removed = entry.derived[*index].bytes();
+        entry.remove_derived(*index);
+        let after = entry.evidence();
+        if after.raw_bytes != current.raw_bytes || after.raw_accounting != current.raw_accounting
+            || after.generation != current.generation
+            || after.global_generation != current.global_generation
+            || after.relfilenode != current.relfilenode || after.row_count != current.row_count
+            || after.derived_bytes.checked_add(removed) != Some(current.derived_bytes) {
+            return Err("targeted derived removal violated footprint conservation".into());
+        }
+        Ok(removed)
+    })
+}
+
+// RawIntegerCount has no retained derived owner. Its fresh-artifact action must
+// be an explicit checked no-op: inspect current raw evidence and require the
+// captured raw recipe owns no derived identity; never evict unrelated Legacy.
+// Backend must preserve the last successful Legacy identity/evidence separately
+// from the Raw recipe because alternating arms share only immutable raw columns.
+
+#[cfg(feature = "pg_test")]
+pub(crate) fn paired_current_raw(
+    expected: ResidentRelationEvidence,
+) -> Result<ResidentRelationEvidence, String> {
+    process_invalidations();
+    STORE.with(|slot| {
+        let store = slot.try_borrow().map_err(|_| "active residency mutation")?;
+        let current = store.entries.iter().find(|entry| entry.relid == expected.relid)
+            .ok_or("raw owner no longer resident")?.evidence();
+        if (current.generation, current.global_generation, current.relfilenode,
+            current.row_count, current.raw_bytes, current.raw_accounting) !=
+           (expected.generation, expected.global_generation, expected.relfilenode,
+            expected.row_count, expected.raw_bytes, expected.raw_accounting) {
+            return Err("raw owner changed".into());
+        }
+        Ok(current)
+    })
+}
+
+#[cfg(feature = "pg_test")]
+pub(crate) fn paired_raw_evidence(relid: pg_sys::Oid) -> Result<ResidentRelationEvidence, String> {
+    process_invalidations();
+    STORE.with(|slot| {
+        let store = slot.try_borrow().map_err(|_| "active residency mutation")?;
+        store.entries.iter().find(|entry| entry.relid == relid)
+            .map(ResidentRelation::evidence).ok_or("raw owner not resident".into())
+    })
+}

