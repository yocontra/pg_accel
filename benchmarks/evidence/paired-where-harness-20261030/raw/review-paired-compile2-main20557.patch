+use super::paired_driver::*;
+use crate::engine::{ffi::planner_hooks, residency, stats};
+use pgrx::{Spi, pg_sys};
+
+pub(crate) struct PgBackend {
+    raw: Option<residency::ResidentRelationEvidence>,
+    legacy_identity: Option<residency::DerivedArtifactIdentity>,
+    sequence: u64,
+}
+impl PgBackend {
+    pub(crate) fn new() -> Self { Self { raw: None, legacy_identity: None, sequence: 0 } }
+    fn key(oid: u32, value: Option<i64>) -> Result<Key, String> {
+        match (oid, value) {
+            (_, None) => Ok(Key::Null),
+            (21, Some(v)) => Ok(Key::I16(v.try_into().map_err(|_| "INT2 range")?)),
+            (23, Some(v)) => Ok(Key::I32(v.try_into().map_err(|_| "INT4 range")?)),
+            (20, Some(v)) => Ok(Key::I64(v)),
+            _ => Err("unsupported result key".into()),
+        }
+    }
+}
+impl Backend for PgBackend {
+    fn assert_default_gucs_and_no_overrides(&mut self) -> Result<(), String> {
+        let valid = Spi::get_one::<bool>("SELECT bool_and(setting=boot_val) FROM pg_settings WHERE name IN ('pg_accel.cost_multiplier','pg_accel.min_batch_size')")
+            .map_err(|e| e.to_string())? == Some(true);
+        if !valid || !crate::engine::gucs::enabled() { return Err("nondefault admission settings".into()); }
+        crate::engine::executor::agg::paired_assert_no_overrides()
+    }
+    fn stock_full_result(&mut self, sql: &str) -> Result<Rows, String> {
+        // Output types come from the unchanged explicit fixture, not from casts
+        // applied to the tested query. Stock cast is only owned scalar decoding.
+        let oid = if sql.contains("raw_where") { 21 } else { 20 };
+        Spi::run("SET pg_accel.enabled=off").map_err(|e| e.to_string())?;
+        let before = crate::gpu::gpu_exec_count();
+        let result = Spi::connect(|client| -> Result<Rows,String> {
+            client.select(&format!("SELECT k::bigint,n::bigint FROM ({sql}) paired_stock"),None,&[])
+                .map_err(|e| e.to_string())?.map(|row| {
+                    let key = Self::key(oid,row.get::<i64>(1).map_err(|e| e.to_string())?)?;
+                    let count = row.get::<i64>(2).map_err(|e| e.to_string())?.ok_or("NULL COUNT")?;
+                    Ok((key,count))
+                }).collect()
+        });
+        Spi::run("SET pg_accel.enabled=on").map_err(|e| e.to_string())?;
+        if crate::gpu::gpu_exec_count()!=before { return Err("stock oracle dispatched GPU".into()); }
+        result
+    }
+    fn capture_independent_recipes(&mut self, sql: &str) -> Result<[Recipe;2],String> {
+        let (_, candidates) = planner_hooks::capture_paired_recipes(|| {
+            Spi::run(&format!("EXPLAIN (VERBOSE) {sql}")).expect("capture unchanged candidate pair")
+        })?;
+        let [legacy,raw] = candidates;
+        if legacy.spec.fact_rel != raw.spec.fact_rel { return Err("candidate owners differ".into()); }
+        let evidence = residency::paired_raw_evidence(raw.spec.fact_rel.into())?;
+        self.raw=Some(evidence);
+        let make = |captured: planner_hooks::PairedRecipe,arm| Recipe {
+            arm, key_type_oid: captured.projection.slots[0].result_type_oid,
+            cost_evidence: captured.cost_components.clone(),
+            relation_generation:evidence.generation,captured,
+        };
+        Ok([make(legacy,Arm::Legacy),make(raw,Arm::Raw)])
+    }
+    fn prepare_jit_outside_measurements(&mut self, recipes: &[Recipe;2]) -> Result<(),String> {
+        for recipe in recipes {
+            let run=self.execute_owned_to_eof(recipe)?;
+            pgrx::notice!("paired_jit arm={:?} evidence={:?} rows={:?}",recipe.arm,run.evidence,run.rows);
+            self.verify_closed_owner_and_raw_residency()?;
+        }
+        Ok(())
+    }
+    fn invalidate_owned_derived_only(&mut self, recipe:&Recipe) -> Result<(),String> {
+        self.verify_closed_owner_and_raw_residency()?;
+        let expected=self.raw.ok_or("raw owner not captured")?;
+        if recipe.arm==Arm::Legacy {
+            let identity=self.legacy_identity.as_ref().ok_or("no successful Legacy artifact identity")?;
+            let bytes=residency::paired_remove_exact_derived(expected,identity)?;
+            pgrx::notice!("paired_exact_invalidation bytes={bytes} identity={:?}",identity.canonical_words());
+        } else {
+            // Raw owns query-local masks only; preserve the unrelated Legacy
+            // artifact and prove unchanged immutable raw ownership instead.
+            residency::paired_current_raw(expected)?;
+        }
+        Ok(())
+    }
+    fn execute_owned_to_eof(&mut self, recipe:&Recipe) -> Result<Run,String> {
+        self.sequence=self.sequence.checked_add(1).ok_or("sequence overflow")?;
+        let sequence=self.sequence;
+        pgrx::notice!("paired_begin sequence={sequence} arm={:?} cost={}",recipe.arm,recipe.cost_evidence);
+        let stock=stats::paired_stock_count();
+        let gpu=crate::gpu::gpu_exec_count();
+        let verified=stats::paired_verified_data_calls();
+        let artifact=stats::read_artifact_lifecycle();
+        let (output,populations)=super::paired_population::capture(|| {
+            pg_sys::PgTryBuilder::new(std::panic::AssertUnwindSafe(|| {
+                // SAFETY: main-backend test entry; installed runner owns every
+                // executor resource through its real PG ERROR boundary.
+                unsafe { super::paired_runner::paired_run_installed(recipe.captured.spec.clone(),
+                    recipe.captured.projection.clone(),recipe.captured.selection) }
+            })).catch_others(|caught| {
+                // Immediate append to captured PG log before rethrow. Never
+                // turn ERROR into a timing sample or silently continue a pair.
+                pgrx::notice!("paired_error sequence={sequence} installed_owner_already_aborted=true");
+                caught.rethrow()
+            }).execute()
+        });
+        pgrx::notice!("paired_unvalidated_output sequence={sequence} key_type={} completed={} mode={:?} calls={} planned={} policy={} artifact_bytes={:?} rows={:?} populations={:?}",
+            output.key_type,output.completed,output.mode,output.calls,output.scheduled,
+            output.artifact_summary,output.artifact_bytes,output.rows,populations);
+        let after=stats::read_artifact_lifecycle();
+        let [owner]=output.residency.as_slice() else { return Err("expected one raw owner".into()); };
+        if output.key_type!=recipe.key_type_oid || output.artifact_bytes.is_none()
+            || output.artifact_summary.is_empty() {
+            return Err("missing typed execution/artifact evidence".into());
+        }
+        if recipe.arm==Arm::Raw && (populations.actual_v2_calls==0
+            || populations.actual_v2_calls!=populations.capacities.len() as u64
+            || populations.leaves.iter().any(|leaf| leaf.input!=owner.row_count)) {
+            return Err("actual v2 call/input observation mismatch".into());
+        }
+        if recipe.arm==Arm::Legacy { self.legacy_identity=Some(output.identity.clone()); }
+        let rows=output.rows.into_iter().map(|(k,n)| Ok((Self::key(output.key_type,k)?,n))).collect::<Result<Rows,String>>()?;
+        let evidence=Evidence {
+            physical_mode:output.mode.ok_or("no actual physical mode")?.label().to_owned(),
+            completed:output.completed,bridge_delta:crate::gpu::gpu_exec_count()-gpu,
+            scheduled_calls:output.scheduled,observed_calls:output.calls,
+            verified_data_calls:stats::paired_verified_data_calls()-verified,
+            stock_fallback_delta:stats::paired_stock_count()-stock,
+            input_rows:owner.row_count,generation:owner.generation,
+            natural_capacity:populations.capacities.first().copied(),
+            explicit_capacity_override:false,
+            artifact_cache_hit:output.artifact_outcome==Some(residency::ArtifactEnsureOutcome::Hit),
+            construction_bytes:after.construction_bytes-artifact.construction_bytes,
+            construction_us:after.construction_us-artifact.construction_us,
+            resident_load_included:!output.loaded_relations.is_empty(),
+            successful_v2_leaves:populations.leaves.into_iter().map(|leaf| SuccessfulV2Leaf {
+                whole_where_rows:leaf.whole,partition_rows:leaf.partition,
+            }).collect(),preparation_ns:output.preparation_ns,
+            dispatch_ns:Some(u128::from(output.dispatch_us)*1000),
+            consumption_ns:output.consumption_ns,end_to_end_ns:output.total_ns,
+        };
+        pgrx::notice!("paired_raw_complete sequence={sequence} evidence={evidence:?} rows={rows:?}");
+        Ok(Run{rows,evidence})
+    }
+    fn retain(&mut self,s:&Sample)->Result<(),String> {
+        pgrx::notice!("paired_components construction_bytes={} construction_us={} preparation_ns={} dispatch_ns={:?} consumption_ns={} end_to_end_ns={} natural_hash_capacity={:?}",
+            s.evidence.construction_bytes,s.evidence.construction_us,s.evidence.preparation_ns,
+            s.evidence.dispatch_ns,s.evidence.consumption_ns,s.evidence.end_to_end_ns,s.evidence.natural_capacity);
+        pgrx::notice!("paired_sample fixture={} phase={:?} pair={} position={} arm={:?} evidence={:?} rows={:?}",s.fixture,s.phase,s.pair,s.position,s.arm,s.evidence,s.rows);Ok(())
+    }
+    fn retain_verdict(&mut self,f:&'static str,p:Phase,n:usize,i:usize,e:Option<&str>)->Result<(),String> {
+        pgrx::notice!("paired_verdict fixture={f} phase={p:?} pair={n} position={i} error={e:?}");Ok(())
+    }
+    fn retain_error(&mut self,f:&'static str,p:Phase,n:usize,i:usize,a:Arm,e:&str)->Result<(),String> {
+        pgrx::notice!("paired_result_error fixture={f} phase={p:?} pair={n} position={i} arm={a:?} error={e}");Ok(())
+    }
+    fn verify_closed_owner_and_raw_residency(&mut self)->Result<(),String> {
+        let counts=super::test_executor_cleanup_counts();
+        if counts.installed!=counts.normal_end.checked_add(counts.query_reset).ok_or("cleanup overflow")? {
+            return Err("executor still installed".into());
+        }
+        residency::paired_current_raw(self.raw.ok_or("no raw baseline")?)?;
+        Ok(())
+    }
+}
diff --git a/pg_accel/src/engine/ffi/custom_scan/paired_driver.rs b/pg_accel/src/engine/ffi/custom_scan/paired_driver.rs
new file mode 100644
index 00000000..18e01a00
--- /dev/null
+++ b/pg_accel/src/engine/ffi/custom_scan/paired_driver.rs
@@ -0,0 +1,175 @@
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Arm { Legacy, Raw }
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Phase { Warmup, Warm, FreshArtifact }
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub enum Key { Null, I16(i16), I32(i32), I64(i64) }
+// Preserve every produced tuple. Never silently overwrite a duplicate key.
+pub type Rows = Vec<(Key, i64)>;
+
+// Owned encoded neutral spec/projection only. Capture each candidate independently
+// AFTER actual ordinary lowering; never relabel Raw words as Legacy.
+#[derive(Clone)]
+pub struct Recipe {
+    pub arm: Arm,
+    pub captured: crate::engine::ffi::planner_hooks::PairedRecipe,
+    pub cost_evidence: String,
+    pub relation_generation: u64,
+    pub key_type_oid: u32,
+}
+
+#[derive(Clone, Debug)]
+pub struct SuccessfulV2Leaf {
+    pub whole_where_rows: u64,
+    pub partition_rows: u64,
+}
+#[derive(Clone, Debug)]
+pub struct Evidence {
+    pub physical_mode: String,
+    pub completed: bool,
+    pub bridge_delta: u64,
+    pub scheduled_calls: u64,
+    pub observed_calls: u64,
+    // Data-bearing verified calls exclude RESET/FINALIZE lifecycle controls.
+    pub verified_data_calls: u64,
+    pub stock_fallback_delta: u64,
+    pub input_rows: u64,
+    pub generation: u64,
+    pub natural_capacity: Option<usize>,
+    pub explicit_capacity_override: bool,
+    pub artifact_cache_hit: bool,
+    pub construction_bytes: u64,
+    pub construction_us: u64,
+    pub resident_load_included: bool,
+    // Must be sourced from native successful-v2 result boundary, never inferred
+    // from parallel_hash or from an absent overflow-only EXPLAIN block.
+    pub successful_v2_leaves: Vec<SuccessfulV2Leaf>,
+    pub preparation_ns: u128,
+    pub dispatch_ns: Option<u128>,
+    pub consumption_ns: u128,
+    pub end_to_end_ns: u128,
+}
+pub struct Run { pub rows: Rows, pub evidence: Evidence }
+pub struct Sample {
+    pub fixture: &'static str, pub phase: Phase, pub pair: usize,
+    pub position: usize, pub arm: Arm, pub evidence: Evidence,
+    pub rows: Rows,
+}
+
+/// Implementation belongs inside the test-only PG module; MUST use production
+/// installed owner/error boundary/AggExecState, not execute_prepared directly.
+/// No method may hold a RefCell or residency borrow over PostgreSQL service.
+pub trait Backend {
+    fn assert_default_gucs_and_no_overrides(&mut self) -> Result<(), String>;
+    fn stock_full_result(&mut self, sql: &str) -> Result<Rows, String>;
+    fn capture_independent_recipes(&mut self, sql: &str) -> Result<[Recipe; 2], String>;
+    fn prepare_jit_outside_measurements(&mut self, recipes: &[Recipe; 2]) -> Result<(), String>;
+    /// Missing targeted invalidation implementation MUST return Err, never
+    /// substitute global cleanup or falsely label a reload as artifact-only.
+    fn invalidate_owned_derived_only(&mut self, recipe: &Recipe) -> Result<(), String>;
+    fn execute_owned_to_eof(&mut self, recipe: &Recipe) -> Result<Run, String>;
+    /// Persist every sample immediately outside the timed interval; bounded,
+    /// append-only evidence output. Return Err on write failure.
+    fn retain(&mut self, sample: &Sample) -> Result<(), String>;
+    /// Append the verdict separately; the full raw sample must already exist.
+    fn retain_verdict(&mut self, fixture: &'static str, phase: Phase, pair: usize,
+                      position: usize, error: Option<&str>) -> Result<(), String>;
+    fn retain_error(&mut self, fixture: &'static str, phase: Phase, pair: usize,
+                    position: usize, arm: Arm, error: &str) -> Result<(), String>;
+    fn verify_closed_owner_and_raw_residency(&mut self) -> Result<(), String>;
+}
+
+fn validate(recipe: &Recipe, run: &Run, expected: &Rows) -> Result<(), String> {
+    let e=&run.evidence;
+    if run.rows.iter().any(|(key,_)| !matches!((recipe.key_type_oid,key),
+        (_,Key::Null)|(21,Key::I16(_))|(23,Key::I32(_))|(20,Key::I64(_)))) {
+        return Err("result key did not retain its declared type".into());
+    }
+    if e.preparation_ns.checked_add(e.consumption_ns).is_none_or(|n| n>e.end_to_end_ns)
+        || e.dispatch_ns.is_none() {
+        return Err("invalid measured interval decomposition".into());
+    }
+    let mut actual = run.rows.clone();
+    let mut oracle = expected.clone();
+    actual.sort(); oracle.sort();
+    if actual!=oracle || !e.completed || e.stock_fallback_delta!=0 ||
+        e.explicit_capacity_override || e.generation!=recipe.relation_generation ||
+        e.bridge_delta!=e.scheduled_calls || e.observed_calls!=e.scheduled_calls ||
+        e.verified_data_calls==0 || e.verified_data_calls>e.observed_calls {
+        return Err("parity/lifecycle/owner/generation proof failed".into());
+    }
+    if recipe.arm==Arm::Raw {
+        if e.physical_mode!="parallel_hash" || e.successful_v2_leaves.is_empty()
+            || e.natural_capacity.is_none_or(|capacity| capacity==0) {
+            return Err("Raw did not prove actual successful v2 routing".into());
+        }
+        let whole=e.successful_v2_leaves[0].whole_where_rows;
+        let mut sum=0_u64;
+        for leaf in &e.successful_v2_leaves {
+            if leaf.whole_where_rows!=whole || leaf.partition_rows>whole || whole>e.input_rows {
+                return Err("v2 whole/leaf population mismatch".into());
+            }
+            sum=sum.checked_add(leaf.partition_rows).ok_or("population overflow")?;
+        }
+        if sum!=whole { return Err("v2 disjoint population conservation failed".into()); }
+    } else if !matches!(e.physical_mode.as_str(),"parallel_dense_count"|"parallel_dense_integer") {
+        return Err("Legacy actual mode outside diagnosed families".into());
+    }
+    Ok(())
+}
+
+// Frozen balanced schedule: five AB and five BA pairs per measured phase.
+pub const ORDER: [[Arm;2];10] = [
+    [Arm::Legacy,Arm::Raw],[Arm::Raw,Arm::Legacy],
+    [Arm::Legacy,Arm::Raw],[Arm::Raw,Arm::Legacy],
+    [Arm::Legacy,Arm::Raw],[Arm::Raw,Arm::Legacy],
+    [Arm::Legacy,Arm::Raw],[Arm::Raw,Arm::Legacy],
+    [Arm::Legacy,Arm::Raw],[Arm::Raw,Arm::Legacy],
+];
+
+pub fn run_fixture<B: Backend>(backend: &mut B, fixture: &'static str, sql: &str)
+    -> Result<(), String>
+{
+    backend.assert_default_gucs_and_no_overrides()?;
+    let expected=backend.stock_full_result(sql)?;
+    let recipes=backend.capture_independent_recipes(sql)?;
+    if recipes[0].arm!=Arm::Legacy || recipes[1].arm!=Arm::Raw {
+        return Err("exact independent candidate pair required".into());
+    }
+    backend.prepare_jit_outside_measurements(&recipes)?;
+    for phase in [Phase::Warmup,Phase::Warm,Phase::FreshArtifact] {
+        let count=if phase==Phase::Warmup {5} else {10};
+        for (pair,order) in ORDER.iter().enumerate().take(count) {
+            for (position,arm) in order.iter().enumerate() {
+                let recipe=&recipes[usize::from(*arm==Arm::Raw)];
+                if phase==Phase::FreshArtifact { backend.invalidate_owned_derived_only(recipe)?; }
+                let run = match backend.execute_owned_to_eof(recipe) {
+                    Ok(run) => run,
+                    Err(error) => {
+                        backend.retain_error(fixture, phase, pair, position, *arm, &error)?;
+                        return Err(error);
+                    }
+                };
+                // Persist unvalidated full output and evidence first. Failure
+                // is not permission to drop a sample or retry for a good one.
+                backend.retain(&Sample { fixture,phase,pair,position,arm:*arm,
+                    evidence:run.evidence.clone(), rows:run.rows.clone() })?;
+                let verdict = (|| {
+                    validate(recipe,&run,&expected)?;
+                    if phase==Phase::Warm && *arm==Arm::Legacy && !run.evidence.artifact_cache_hit {
+                        return Err("warm Legacy artifact miss; retain failure, no retry".into());
+                    }
+                    if phase==Phase::FreshArtifact && (run.evidence.artifact_cache_hit ||
+                                                      run.evidence.resident_load_included) {
+                        return Err("fresh-artifact phase mislabeled".into());
+                    }
+                    backend.verify_closed_owner_and_raw_residency()
+                })();
+                backend.retain_verdict(fixture,phase,pair,position,verdict.as_ref().err().map(String::as_str))?;
+                verdict?;
+            }
+        }
+    }
+    Ok(())
+}
