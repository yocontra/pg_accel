+       CounterIndex >= NumCounters64) {
+      llvm::report_fatal_error(
+          llvm::Twine{"invalid device profiling counter bounds for "} +
+          ProfileName);
+    }
+    return {std::move(ProfileName), Hash,
+            static_cast<uint32_t>(NumCounters64)};
+  };
