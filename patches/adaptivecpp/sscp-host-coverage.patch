diff --git a/src/compiler/sscp/TargetSeparationPass.cpp b/src/compiler/sscp/TargetSeparationPass.cpp
index f3202ceb..64353d67 100644
--- a/src/compiler/sscp/TargetSeparationPass.cpp
+++ b/src/compiler/sscp/TargetSeparationPass.cpp
@@ -40,0 +41 @@
+#include <llvm/Support/ErrorHandling.h>
@@ -280,0 +282,67 @@ void removeLinkerOptionsByPrefixes(
+static bool isHostProfileIntrinsic(const llvm::Function &F) {
+  return llvmutils::starts_with(F.getName(), "llvm.instrprof.");
+}
+
+static void requireNoHostProfileInstrumentation(const llvm::Module &M) {
+  for(const auto& F : M) {
+    if(isHostProfileIntrinsic(F)) {
+      llvm::report_fatal_error(
+          "host profiling intrinsic survived SSCP device separation: " +
+          F.getName());
+    }
+  }
+}
+
+static void stripHostProfileInstrumentation(llvm::Module &M) {
+  llvm::SmallVector<llvm::Function *, 8> ProfileIntrinsics;
+  for(auto& F : M) {
+    if(isHostProfileIntrinsic(F))
+      ProfileIntrinsics.push_back(&F);
+  }
+
+  for(auto* F : ProfileIntrinsics) {
+    llvm::SmallVector<llvm::CallBase *, 16> Calls;
+    for(auto* U : F->users()) {
+      auto* Call = llvm::dyn_cast<llvm::CallBase>(U);
+      if(!Call || Call->getCalledOperand()->stripPointerCasts() != F ||
+         !Call->getType()->isVoidTy()) {
+        llvm::report_fatal_error(
+            "unsupported use of host profiling intrinsic in SSCP device IR: " +
+            F->getName());
+      }
+      Calls.push_back(Call);
+    }
+
+    for(auto* Call : Calls)
+      Call->eraseFromParent();
+
+    if(!F->use_empty()) {
+      llvm::report_fatal_error(
+          "host profiling intrinsic still has uses in SSCP device IR: " +
+          F->getName());
+    }
+    F->eraseFromParent();
+  }
+
+  requireNoHostProfileInstrumentation(M);
+}
+
+static bool preserveHostCoverageMappingNames(llvm::Module &M) {
+  if(auto* CoverageNames = M.getGlobalVariable("__llvm_coverage_names", true)) {
+    CoverageNames->setLinkage(llvm::GlobalValue::ExternalLinkage);
+    return true;
+  }
+  return false;
+}
+
+static void restoreHostCoverageMappingNames(llvm::Module &M, bool Required) {
+  if(!Required)
+    return;
+  auto* CoverageNames = M.getGlobalVariable("__llvm_coverage_names", true);
+  if(!CoverageNames) {
+    llvm::report_fatal_error(
+        "host coverage mapping names were dropped during SSCP separation");
+  }
+  CoverageNames->setLinkage(llvm::GlobalValue::InternalLinkage);
+}
+
@@ -289,0 +358 @@ std::unique_ptr<llvm::Module> generateDeviceIR(llvm::Module &M,
+  stripHostProfileInstrumentation(*DeviceModule);
@@ -327,0 +397 @@ std::unique_ptr<llvm::Module> generateDeviceIR(llvm::Module &M,
+  AttrsToRemove.push_back(llvm::Attribute::AttrKind::OptimizeNone);
@@ -478,0 +549,2 @@ std::unique_ptr<llvm::Module> generateDeviceIR(llvm::Module &M,
+  requireNoHostProfileInstrumentation(*DeviceModule);
+
@@ -644,0 +717 @@ llvm::PreservedAnalyses TargetSeparationPass::run(llvm::Module &M,
+      bool HasCoverageMappingNames = preserveHostCoverageMappingNames(M);
@@ -645,0 +719 @@ llvm::PreservedAnalyses TargetSeparationPass::run(llvm::Module &M,
+      restoreHostCoverageMappingNames(M, HasCoverageMappingNames);
