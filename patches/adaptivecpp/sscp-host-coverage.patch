+    if (!decode_profile_name(hex_name, name)) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: invalid device profile record name"});
+    }
+    _device_profile_records.push_back(device_profile_record{
+        std::move(name), hash, static_cast<uint32_t>(count),
+        static_cast<uint32_t>(base)});
+  }
+
+  if (!header_seen) return make_success();
+  if (_device_profile_records.empty()) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile header has no records"});
+  }
+
+  uint64_t expected_base = 0;
+  std::set<std::pair<std::string, uint64_t>> unique_records;
+  for (const auto& record : _device_profile_records) {
+    if (record.base_counter != expected_base ||
+        !unique_records.emplace(record.name, record.hash).second) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: non-contiguous or duplicate device profile records"});
+    }
+    expected_base += record.num_counters;
+  }
+  if (expected_base != declared_counters) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile counter total mismatch"});
+  }
+  if (!_device) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: cannot allocate device profile buffer without a device"});
+  }
+
+  _device_profile_counter_count = static_cast<uint32_t>(declared_counters);
+  const std::size_t slots = static_cast<std::size_t>(declared_counters) + 1;
+  if (slots > std::numeric_limits<std::size_t>::max() / sizeof(uint32_t)) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile buffer size overflow"});
