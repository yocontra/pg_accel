+  for(auto *Call : Calls) {
+    auto *Intrinsic = Call->getCalledFunction();
+    llvm::StringRef IntrinsicName = Intrinsic->getName();
+    RecordKey Key = readRecordKey(*Call);
+    const uint64_t CounterIndex =
+        getConstantProfileOperand(*Call, 3, "counter index");
