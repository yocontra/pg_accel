+static void lowerDeviceProfileInstrumentation(llvm::Module &M) {
+  bool HasReservedProfileSymbol = false;
+  for(const auto &GV : M.global_values()) {
+    llvm::StringRef Name = GV.getName();
+    Name.consume_front("\1");
+    HasReservedProfileSymbol |= Name == DeviceProfileIncrement;
+  }
+  bool HasReservedProfileCarrier = false;
+  for(const auto &F : M) {
+    for(const auto &BB : F) {
+      for(const auto &I : BB) {
+        auto *Call = llvm::dyn_cast<llvm::CallBase>(&I);
+        if(!Call)
+          continue;
+        HasReservedProfileCarrier |=
+            Call->getOperandBundle(DeviceProfileBatchBundle).has_value();
+      }
+    }
