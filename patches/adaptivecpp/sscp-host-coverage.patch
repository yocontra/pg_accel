+    }
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile buffer allocation failed"});
+  }
+  std::memset(_device_profile_buffer->contents(), 0, bytes);
+  return make_success();
+}
+
+void metal_sscp_executable_object::flush_device_profile() const {
+  const char* output_dir = std::getenv("ACPP_METAL_DEVICE_PROFILE_DIR");
+  if (!output_dir || output_dir[0] == '\0') return;
+  if (_device_profile_records.empty()) {
+    if (_device_profile_buffer) {
+      fail_device_profile_flush(
+          "profile buffer exists without device profile metadata");
+    }
+    return;
+  }
+  if (!_device_profile_buffer) {
+    fail_device_profile_flush("device profile metadata has no counter buffer");
+  }
+
+  const std::size_t slots =
+      static_cast<std::size_t>(_device_profile_counter_count) + 1;
+  const std::size_t bytes = slots * sizeof(uint32_t);
+  if (!_device_profile_buffer->contents() ||
+      _device_profile_buffer->length() < bytes) {
+    fail_device_profile_flush("invalid device profile counter buffer");
+  }
+
+  const auto* counters =
+      static_cast<const uint32_t*>(_device_profile_buffer->contents());
+  const bool overflow = counters[_device_profile_counter_count] != 0;
+  bool any_nonzero = false;
+  for (uint32_t i = 0; i < _device_profile_counter_count; ++i) {
+    any_nonzero |= counters[i] != 0;
+  }
+  if (!any_nonzero && !overflow) return;
+
+  std::error_code ec;
+  std::filesystem::create_directories(output_dir, ec);
+  if (ec) {
+    fail_device_profile_flush(
+        std::string{"could not create device profile directory: "} +
+        ec.message());
+  }
+  if (!std::filesystem::is_directory(output_dir, ec) || ec) {
+    fail_device_profile_flush(
+        ec ? std::string{"could not inspect device profile directory: "} +
+                 ec.message()
+           : "device profile output path is not a directory");
+  }
+  const std::string stem =
+      std::string{"acpp-metal-device-"} + private_tmp_suffix() + "-" +
+      kernel_configuration::to_string(_id);
+
+  if (overflow) {
+    const std::string error_path =
+        common::filesystem::join_path(output_dir, stem + ".overflow");
+    write_device_profile_or_exit(
+        error_path,
+        "Metal device coverage counter overflow; profile rejected\n",
+        "device profile overflow marker");
+    HIPSYCL_DEBUG_WARNING
+        << "metal_code_object: device profile counter overflow; wrote "
+        << error_path << std::endl;
+    return;
+  }
+
+  std::ostringstream profile;
+  for (const auto& record : _device_profile_records) {
+    profile << record.name << "\n# Func Hash:\n" << record.hash
+            << "\n# Num Counters:\n" << record.num_counters
+            << "\n# Counter Values:\n";
+    for (uint32_t i = 0; i < record.num_counters; ++i) {
+      profile << counters[record.base_counter + i] << "\n";
+    }
+    profile << "\n";
+  }
+  const std::string profile_path =
+      common::filesystem::join_path(output_dir, stem + ".proftext");
+  write_device_profile_or_exit(profile_path, profile.str(),
+                               "device profile");
+  HIPSYCL_DEBUG_INFO
+      << "metal_code_object: wrote Metal device profile " << profile_path
+      << std::endl;
+}
+
