+[[noreturn]] void fail_device_profile_write(const std::string& path,
+                                            const std::string& temp_path,
+                                            int fd, const char* description,
+                                            const std::string& reason,
+                                            bool final_created = false) {
+  if (fd >= 0) ::close(fd);
+  remove_device_profile_file(temp_path);
