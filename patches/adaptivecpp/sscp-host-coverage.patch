+  // if LLVM changes the iteration order of intrinsic users.
+  for(auto *Call : Calls) {
+    RecordKey Key = readRecordKey(*Call);
+    const auto &[Name, Hash, NumCounters] = Key;
+    auto [CountIt, Inserted] =
+        RecordCounterCounts.emplace(std::make_pair(Name, Hash), NumCounters);
+    if(!Inserted && CountIt->second != NumCounters) {
+      llvm::report_fatal_error(
+          llvm::Twine{"conflicting device profile counter counts for "} + Name);
+    }
+    RecordBases.emplace(std::move(Key), 0);
+  }
+  for(auto &[Key, Base] : RecordBases) {
+    const auto &[Name, Hash, NumCounters] = Key;
+    if(NextCounter + NumCounters > UINT32_MAX) {
+      llvm::report_fatal_error(
+          "SSCP device profile requires more than UINT32_MAX counters");
+    }
+    Base = static_cast<uint32_t>(NextCounter);
+    Records.push_back(DeviceProfileRecord{Name, Hash, NumCounters, Base});
+    NextCounter += NumCounters;
+  }
+
+  struct FunctionAccumulators {
+    std::map<uint32_t, llvm::AllocaInst *> Slots;
+  };
+  std::map<llvm::Function *, FunctionAccumulators> Accumulators;
+
+  // First validate every site and determine the per-function accumulator
+  // layout. The local sums are pure data flow: LLVM can still if-convert and
+  // simplify the instrumented CFG before the Metal side effect is introduced.
+  for(auto *Call : Calls) {
+    auto *Intrinsic = Call->getCalledFunction();
+    llvm::StringRef IntrinsicName = Intrinsic->getName();
+    if(IntrinsicName != "llvm.instrprof.increment" &&
+       IntrinsicName != "llvm.instrprof.increment.step") {
