+
+void write_device_profile_or_exit(const std::string& path,
+                                  const std::string& data,
+                                  const char* description) {
+  const std::string temp_path = path + "." + private_tmp_suffix() + ".tmp";
+  int fd = ::open(temp_path.c_str(),
+                  O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+  if (fd < 0) {
+    fail_device_profile_write(path, temp_path, -1, description,
+                              std::strerror(errno));
+  }
+
+  std::size_t written = 0;
+  while (written < data.size()) {
+    const ssize_t count =
+        ::write(fd, data.data() + written, data.size() - written);
+    if (count < 0 && errno == EINTR) continue;
+    if (count <= 0) {
+      const std::string reason =
+          count < 0 ? std::strerror(errno) : "write returned zero bytes";
+      fail_device_profile_write(path, temp_path, fd, description, reason);
+    }
+    written += static_cast<std::size_t>(count);
+  }
+
+  while (::fsync(fd) < 0) {
+    if (errno == EINTR) continue;
+    fail_device_profile_write(path, temp_path, fd, description,
+                              std::strerror(errno));
+  }
+  if (::close(fd) != 0) {
+    fd = -1;
+    fail_device_profile_write(path, temp_path, fd, description,
+                              std::string{"close failed: "} +
+                                  std::strerror(errno));
+  }
+  fd = -1;
+
+  if (::rename(temp_path.c_str(), path.c_str()) != 0) {
+    fail_device_profile_write(path, temp_path, fd, description,
+                              std::string{"rename failed: "} +
+                                  std::strerror(errno));
+  }
+
+  std::error_code ec;
+  const auto final_size = std::filesystem::file_size(path, ec);
+  if (ec || final_size != data.size()) {
+    const std::string reason =
+        ec ? std::string{"final size check failed: "} + ec.message()
+           : "final size differs from requested payload";
+    fail_device_profile_write(path, temp_path, fd, description, reason, true);
+  }
+
+  std::ifstream input{path, std::ios::binary};
+  const std::string actual{std::istreambuf_iterator<char>{input},
+                           std::istreambuf_iterator<char>{}};
+  if (!input.is_open() || input.bad() || actual != data) {
+    fail_device_profile_write(path, temp_path, fd, description,
+                              "final content verification failed", true);
+  }
+}
