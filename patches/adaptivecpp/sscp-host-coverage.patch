+          "metal_code_object: device profile record precedes header"});
+    }
+    uint64_t base = 0;
+    uint64_t count = 0;
+    uint64_t hash = 0;
+    std::string hex_name;
+    std::string trailing;
+    std::istringstream fields{line.substr(std::strlen(Record))};
+    if (!(fields >> base >> count >> hash >> hex_name) || (fields >> trailing) ||
