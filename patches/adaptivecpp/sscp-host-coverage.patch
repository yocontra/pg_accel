+    llvm::Value *Step = llvm::ConstantInt::get(I64, 1);
+    if(IntrinsicName == "llvm.instrprof.increment.step")
+      Step = Call->getArgOperand(4);
+    llvm::IRBuilder<> Builder{Call};
+    Builder.SetCurrentDebugLocation(Call->getDebugLoc());
+    Step = Builder.CreateZExtOrTrunc(Step, I64);
+    llvm::Value *Old = Builder.CreateLoad(I64, AccumulatorIt->second);
+    llvm::Value *Sum = Builder.CreateAdd(Old, Step);
+    llvm::Value *Overflow = Builder.CreateICmpULT(Sum, Old);
+    llvm::Value *Saturated = Builder.CreateSelect(
+        Overflow, llvm::ConstantInt::get(I64, UINT64_MAX), Sum);
+    Builder.CreateStore(Saturated, AccumulatorIt->second);
+  }
+
+  llvm::FunctionCallee ProfileCarrier =
+      llvm::Intrinsic::getOrInsertDeclaration(&M, llvm::Intrinsic::donothing);
+  for(auto &[F, FunctionState] : Accumulators) {
+    bool HasReturn = false;
+    for(auto &BB : *F) {
+      auto *Return = llvm::dyn_cast<llvm::ReturnInst>(BB.getTerminator());
+      if(!Return)
+        continue;
+      HasReturn = true;
+      llvm::IRBuilder<> Builder{Return};
+      llvm::SmallVector<llvm::Value *, 16> BatchInputs;
+      for(const auto &[Slot, Accumulator] : FunctionState.Slots) {
+        BatchInputs.push_back(llvm::ConstantInt::get(I32, Slot + 1));
+        BatchInputs.push_back(Builder.CreateLoad(I64, Accumulator));
+      }
+      llvm::OperandBundleDef BatchBundle{
+          std::string{DeviceProfileBatchBundle}, BatchInputs};
+      Builder.CreateCall(ProfileCarrier, {}, {BatchBundle});
+    }
+    if(!HasReturn)
+      llvm::report_fatal_error(
+          "instrumented SSCP device function has no return");
+  }
+
+  llvm::NamedMDNode *Metadata = M.getOrInsertNamedMetadata(DeviceProfileRecords);
+  if(Metadata->getNumOperands() != 0)
+    llvm::report_fatal_error("duplicate SSCP device profile metadata");
+  for(const auto &Record : Records) {
+    Metadata->addOperand(llvm::MDNode::get(
+        Ctx,
+        {llvm::MDString::get(Ctx, Record.Name),
+         llvm::ConstantAsMetadata::get(llvm::ConstantInt::get(I64, Record.Hash)),
+         llvm::ConstantAsMetadata::get(
+             llvm::ConstantInt::get(I32, Record.NumCounters)),
+         llvm::ConstantAsMetadata::get(
+             llvm::ConstantInt::get(I32, Record.BaseCounter))}));
+  }
+
+  for(auto *Call : Calls)
+    Call->eraseFromParent();
+  llvm::SmallVector<llvm::Function *, 8> ProfileIntrinsics;
+  for(auto &F : M)
+    if(isHostProfileIntrinsic(F))
+      ProfileIntrinsics.push_back(&F);
+  for(auto *F : ProfileIntrinsics) {
+    if(!F->use_empty())
+      llvm::report_fatal_error(
+          "profiling intrinsic survived device hit marking: " + F->getName());
+    F->eraseFromParent();
+  }
+  requireNoHostProfileInstrumentation(M);
+}
