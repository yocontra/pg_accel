+bool decode_profile_name(const std::string& hex, std::string& out) {
+  auto digit = [](char c) -> int {
+    if (c >= '0' && c <= '9') return c - '0';
+    if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+    if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+    return -1;
+  };
+  if (hex.empty() || (hex.size() & 1) != 0) return false;
+  out.clear();
+  out.reserve(hex.size() / 2);
+  for (std::size_t i = 0; i < hex.size(); i += 2) {
+    int hi = digit(hex[i]);
+    int lo = digit(hex[i + 1]);
+    if (hi < 0 || lo < 0) return false;
+    char value = static_cast<char>((hi << 4) | lo);
+    if (value == '\0' || value == '\n' || value == '\r') return false;
+    out.push_back(value);
+  }
+  return !out.empty();
+}
