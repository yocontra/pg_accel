+  using RecordKey = std::tuple<std::string, uint64_t, uint32_t>;
+  std::map<RecordKey, uint32_t> RecordBases;
+  std::map<std::pair<std::string, uint64_t>, uint32_t> RecordCounterCounts;
+  std::vector<DeviceProfileRecord> Records;
+  uint64_t NextCounter = 0;
+  auto &Ctx = M.getContext();
+  auto *I32 = llvm::Type::getInt32Ty(Ctx);
+  auto *I64 = llvm::Type::getInt64Ty(Ctx);
+
+  auto readRecordKey = [](llvm::CallBase &Call) -> RecordKey {
+    std::string ProfileName = getDeviceProfileName(Call);
+    uint64_t Hash = getConstantProfileOperand(Call, 1, "function hash");
+    uint64_t NumCounters64 =
+        getConstantProfileOperand(Call, 2, "counter count");
+    uint64_t CounterIndex =
+        getConstantProfileOperand(Call, 3, "counter index");
