+    }
+    const unsigned ExpectedArgs =
+        IntrinsicName == "llvm.instrprof.increment.step" ? 5 : 4;
+    if(Call->arg_size() != ExpectedArgs) {
+      llvm::report_fatal_error(
+          "device profile intrinsic has an unexpected signature");
+    }
+    readRecordKey(*Call);
+    if(IntrinsicName == "llvm.instrprof.increment.step" &&
+       !Call->getArgOperand(4)->getType()->isIntegerTy()) {
+        llvm::report_fatal_error(
+            "device profile increment.step has a non-integer step");
+    }
+
+    RecordKey Key = readRecordKey(*Call);
+    const uint64_t CounterIndex =
+        getConstantProfileOperand(*Call, 3, "counter index");
+    auto BaseIt = RecordBases.find(Key);
+    if(BaseIt == RecordBases.end())
+      llvm::report_fatal_error(
+          "device profile record layout changed while marking hits");
+
+    auto *Parent = Call->getFunction();
+    if(!Parent || Parent->isDeclaration())
+      llvm::report_fatal_error(
+          "device profile increment has no defined parent function");
+    const uint64_t Slot = BaseIt->second + CounterIndex;
+    Accumulators[Parent].Slots.emplace(static_cast<uint32_t>(Slot), nullptr);
+  }
+
+  for(auto &[F, FunctionState] : Accumulators) {
+    llvm::IRBuilder<> EntryBuilder{&*F->getEntryBlock().getFirstInsertionPt()};
+    for(auto &[Slot, Accumulator] : FunctionState.Slots) {
+      Accumulator = EntryBuilder.CreateAlloca(
+          I64, nullptr, "__acpp_device_profile_sum");
+      EntryBuilder.CreateStore(llvm::ConstantInt::get(I64, 0), Accumulator);
+    }
+  }
+
+  for(auto *Call : Calls) {
+    auto *Intrinsic = Call->getCalledFunction();
+    llvm::StringRef IntrinsicName = Intrinsic->getName();
+    RecordKey Key = readRecordKey(*Call);
+    const uint64_t CounterIndex =
+        getConstantProfileOperand(*Call, 3, "counter index");
+    auto BaseIt = RecordBases.find(Key);
+    auto FunctionIt = Accumulators.find(Call->getFunction());
+    if(BaseIt == RecordBases.end() || FunctionIt == Accumulators.end())
+      llvm::report_fatal_error(
+          "device profile accumulator layout changed while marking hits");
+    const uint64_t Slot = BaseIt->second + CounterIndex;
+    auto AccumulatorIt =
+        FunctionIt->second.Slots.find(static_cast<uint32_t>(Slot));
+    if(AccumulatorIt == FunctionIt->second.Slots.end() ||
+       !AccumulatorIt->second)
+      llvm::report_fatal_error("device profile accumulator is missing");
