+static bool preserveHostCoverageMappingNames(llvm::Module &M) {
+  if(auto* CoverageNames = M.getGlobalVariable("__llvm_coverage_names", true)) {
+    CoverageNames->setLinkage(llvm::GlobalValue::ExternalLinkage);
+    return true;
+  }
+  return false;
+}
+
+static void restoreHostCoverageMappingNames(llvm::Module &M, bool Required) {
+  if(!Required)
+    return;
+  auto* CoverageNames = M.getGlobalVariable("__llvm_coverage_names", true);
+  if(!CoverageNames) {
+    llvm::report_fatal_error(
+        "host coverage mapping names were dropped during SSCP separation");
+  }
+  CoverageNames->setLinkage(llvm::GlobalValue::InternalLinkage);
+}
