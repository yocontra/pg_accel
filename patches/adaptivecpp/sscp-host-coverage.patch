+static std::string getDeviceProfileName(const llvm::CallBase &Call) {
+  llvm::StringRef Name;
+  if(Call.arg_size() < 1 ||
+     !llvm::getConstantStringInfo(Call.getArgOperand(0), Name)) {
+    llvm::report_fatal_error(
+        "device profiling intrinsic has no constant profile name");
+  }
+  return Name.str();
+}
+
+static uint64_t getConstantProfileOperand(const llvm::CallBase &Call,
+                                          unsigned Index,
+                                          llvm::StringRef Description) {
+  if(Call.arg_size() <= Index) {
+    llvm::report_fatal_error("device profiling intrinsic is missing " +
+                             Description);
+  }
+  auto *Value = llvm::dyn_cast<llvm::ConstantInt>(Call.getArgOperand(Index));
+  if(!Value) {
+    llvm::report_fatal_error("device profiling intrinsic has non-constant " +
+                             Description);
+  }
+  return Value->getZExtValue();
+}
