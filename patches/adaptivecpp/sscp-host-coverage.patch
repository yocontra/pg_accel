+  return llvmutils::starts_with(F.getName(), "llvm.instrprof.");
+}
+
+static constexpr const char *DeviceProfileIncrement =
+    "__acpp_sscp_metal_profile_increment";
+static constexpr const char *DeviceProfileRecords =
+    "acpp.metal.device.profile.records";
+static constexpr const char *DeviceProfileBatchBundle =
+    "acpp.metal.device.profile.batch";
+
+static void requireNoHostProfileInstrumentation(const llvm::Module &M) {
+  for(const auto& F : M) {
+    if(isHostProfileIntrinsic(F)) {
+      llvm::report_fatal_error(
+          "host profiling intrinsic survived SSCP device separation: " +
+          F.getName());
+    }
+  }
+}
+
+struct DeviceProfileRecord {
+  std::string Name;
+  uint64_t Hash;
+  uint32_t NumCounters;
+  uint32_t BaseCounter;
+};
+
+static std::string getDeviceProfileName(const llvm::CallBase &Call) {
+  llvm::StringRef Name;
+  if(Call.arg_size() < 1 ||
+     !llvm::getConstantStringInfo(Call.getArgOperand(0), Name)) {
+    llvm::report_fatal_error(
+        "device profiling intrinsic has no constant profile name");
+  }
+  return Name.str();
+}
+
+static uint64_t getConstantProfileOperand(const llvm::CallBase &Call,
+                                          unsigned Index,
+                                          llvm::StringRef Description) {
+  if(Call.arg_size() <= Index) {
+    llvm::report_fatal_error("device profiling intrinsic is missing " +
+                             Description);
+  }
+  auto *Value = llvm::dyn_cast<llvm::ConstantInt>(Call.getArgOperand(Index));
+  if(!Value) {
+    llvm::report_fatal_error("device profiling intrinsic has non-constant " +
+                             Description);
+  }
+  return Value->getZExtValue();
+}
+
+static void lowerDeviceProfileInstrumentation(llvm::Module &M) {
+  bool HasReservedProfileSymbol = false;
+  for(const auto &GV : M.global_values()) {
+    llvm::StringRef Name = GV.getName();
+    Name.consume_front("\1");
+    HasReservedProfileSymbol |= Name == DeviceProfileIncrement;
+  }
+  bool HasReservedProfileCarrier = false;
+  for(const auto &F : M) {
+    for(const auto &BB : F) {
+      for(const auto &I : BB) {
+        auto *Call = llvm::dyn_cast<llvm::CallBase>(&I);
+        if(!Call)
+          continue;
+        HasReservedProfileCarrier |=
+            Call->getOperandBundle(DeviceProfileBatchBundle).has_value();
+      }
+    }
+  }
+  if(HasReservedProfileSymbol || HasReservedProfileCarrier ||
+     M.getNamedMetadata(DeviceProfileRecords)) {
+    llvm::report_fatal_error(
+        "reserved SSCP device profile symbol or metadata already exists");
+  }
+
+  llvm::SmallVector<llvm::CallBase *, 32> Calls;
+  for(auto &F : M) {
+    if(!isHostProfileIntrinsic(F))
+      continue;
+    for(auto *U : F.users()) {
+      auto *Call = llvm::dyn_cast<llvm::CallBase>(U);
+      if(!Call || Call->getCalledOperand()->stripPointerCasts() != &F ||
+         !Call->getType()->isVoidTy()) {
+        llvm::report_fatal_error(
+            "unsupported use of host profiling intrinsic in SSCP device IR: " +
+            F.getName());
+      }
+      Calls.push_back(Call);
+    }
+  }
+
+  if(Calls.empty()) {
+    llvm::SmallVector<llvm::Function *, 8> EmptyIntrinsics;
+    for(auto &F : M)
+      if(isHostProfileIntrinsic(F) && F.use_empty())
+        EmptyIntrinsics.push_back(&F);
+    for(auto *F : EmptyIntrinsics)
+      F->eraseFromParent();
