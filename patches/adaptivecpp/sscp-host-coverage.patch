+bool MetalEmitter::analyzeDeviceProfileMetadata() {
+  static constexpr const char* MetadataName =
+      "acpp.metal.device.profile.records";
+  NamedMDNode* Metadata = M.getNamedMetadata(MetadataName);
+  if (!Metadata) {
+    return true;
+  }
+  if (Metadata->getNumOperands() == 0) {
+    errorMsg = "Metal device profile metadata is empty";
+    return false;
+  }
+  if (opt.maxArgsForFlatMode < 1) {
+    errorMsg = "Metal device profiling has no free implicit buffer binding";
+    return false;
+  }
+
+  auto readInteger = [&](llvm::Metadata* MD, uint64_t& Out) -> bool {
+    auto* ConstantMD = dyn_cast<ConstantAsMetadata>(MD);
+    auto* Value = ConstantMD ? dyn_cast<ConstantInt>(ConstantMD->getValue()) : nullptr;
+    if (!Value) {
+      return false;
+    }
+    Out = Value->getZExtValue();
+    return true;
+  };
+
+  uint64_t ExpectedBase = 0;
+  for (unsigned I = 0; I < Metadata->getNumOperands(); ++I) {
+    MDNode* Node = Metadata->getOperand(I);
+    if (!Node || Node->getNumOperands() != 4) {
+      errorMsg = "Malformed Metal device profile record metadata";
+      return false;
+    }
+    auto* Name = dyn_cast<MDString>(Node->getOperand(0).get());
+    uint64_t Hash = 0;
+    uint64_t NumCounters = 0;
+    uint64_t BaseCounter = 0;
+    if (!Name || Name->getString().empty() ||
+        !readInteger(Node->getOperand(1).get(), Hash) ||
+        !readInteger(Node->getOperand(2).get(), NumCounters) ||
+        !readInteger(Node->getOperand(3).get(), BaseCounter) ||
+        NumCounters == 0 || NumCounters > UINT32_MAX ||
+        BaseCounter != ExpectedBase ||
+        ExpectedBase + NumCounters > UINT32_MAX) {
+      errorMsg = "Invalid or non-contiguous Metal device profile record metadata";
+      return false;
+    }
+    deviceProfileRecords.push_back(DeviceProfileRecord{
+        Name->getString().str(), Hash, static_cast<uint32_t>(NumCounters),
+        static_cast<uint32_t>(BaseCounter)});
+    ExpectedBase += NumCounters;
+  }
+  deviceProfileCounterCount = static_cast<uint32_t>(ExpectedBase);
+  return true;
+}
+
+void MetalEmitter::emitDeviceProfileMetadata() {
+  if (deviceProfileRecords.empty()) {
+    return;
+  }
+  static constexpr char Hex[] = "0123456789abcdef";
+  auto hexEncode = [&](const std::string& Input) {
+    std::string Result;
+    Result.reserve(Input.size() * 2);
+    for (unsigned char C : Input) {
+      Result.push_back(Hex[C >> 4]);
+      Result.push_back(Hex[C & 0xf]);
+    }
+    return Result;
+  };
+
+  os << "// __ACPP_DEVICE_PROFILE_V1 " << deviceProfileCounterCount << "\n";
+  for (const auto& Record : deviceProfileRecords) {
+    os << "// __ACPP_DEVICE_PROFILE_RECORD " << Record.baseCounter << " "
+       << Record.numCounters << " " << Record.hash << " "
+       << hexEncode(Record.name) << "\n";
+  }
+}
+
+void MetalEmitter::emitDeviceProfileIncrementHelper() {
+  if (deviceProfileRecords.empty()) {
+    return;
+  }
+
+  // Keep the split 64-bit counter update in one non-inlined MSL helper.
+  // Expanding this sequence at every instrumented basic block made coverage
+  // metallibs several times larger and exhausted the hosted virtual-M1
+  // compiler service before an archive could be produced.
+  os << R"__(
+__attribute__((noinline)) void __acpp_sscp_metal_profile_add(
+    device atomic_uint* counters, uint slot, ulong step,
+    bool intrinsic_overflow) {
+  const uint low_step = uint(step);
+  const uint high_step = uint(step >> 32);
+  const uint low_slot = slot * uint(2);
+  const uint old_low = atomic_fetch_add_explicit(
+      counters + low_slot, low_step, memory_order_relaxed);
+  const uint carry = old_low > (~uint(0) - low_step) ? uint(1) : uint(0);
+  const uint high_add = high_step + carry;
+  const uint old_high = atomic_fetch_add_explicit(
+      counters + low_slot + uint(1), high_add, memory_order_relaxed);
+  if (high_add < high_step || old_high > (~uint(0) - high_add) ||
+      intrinsic_overflow) {
+    atomic_store_explicit(counters + )__"
+     << static_cast<uint64_t>(deviceProfileCounterCount) * 2
+     << R"__(, uint(1), memory_order_relaxed);
+  }
+}
+
+)__";
+}
+
+int MetalEmitter::flatArgumentLimit() const {
+  return opt.maxArgsForFlatMode - (deviceProfileRecords.empty() ? 0 : 1);
+}
+
+bool MetalEmitter::functionNeedsDeviceProfile(const Function& F) const {
+  return deviceProfileFunctions.count(&F) != 0;
+}
+
+bool MetalEmitter::lowerDeviceProfileIntrinsics() {
+  if (deviceProfileRecords.empty()) {
+    return true;
+  }
+
+  for (const GlobalValue& GV : M.global_values()) {
+    StringRef Name = GV.getName();
+    Name.consume_front("\1");
+    if (Name == "__acpp_sscp_metal_profile_increment" ||
+        Name == "__acpp_sscp_metal_profile_add") {
+      errorMsg = "Reserved Metal device profile symbol already exists";
+      return false;
+    }
+  }
+
+  for (Function& F : M) {
+    if (F.getName().starts_with("llvm.instrprof.") && !F.use_empty()) {
+      errorMsg = "Profiling intrinsic survived Metal device hit marking";
+      return false;
+    }
+  }
+
+  struct ProfileHit {
+    CallBase* carrier;
+    uint32_t slot;
+    Value* step;
+    Value* overflow;
+  };
+  SmallVector<ProfileHit, 32> Hits;
+  SmallPtrSet<CallBase*, 32> Carriers;
+  static constexpr const char* BatchBundleName =
+      "acpp.metal.device.profile.batch";
+  for (Function& F : M) {
+    for (BasicBlock& BB : F) {
+      for (Instruction& I : BB) {
+        auto* Call = dyn_cast<CallBase>(&I);
+        auto BatchBundle = Call ? Call->getOperandBundle(BatchBundleName)
+                                : std::nullopt;
+        if (!BatchBundle) {
+          continue;
+        }
+        Function* Callee = Call ? Call->getCalledFunction() : nullptr;
+        if (!Callee || Callee->getIntrinsicID() != Intrinsic::donothing ||
+            !Call->arg_empty() || Call->getNumOperandBundles() != 1 ||
+            BatchBundle->Inputs.empty() ||
+            (BatchBundle->Inputs.size() % 3) != 0) {
+          errorMsg = "Invalid or unrecognized Metal device profile carrier";
+          return false;
+        }
+        Carriers.insert(Call);
+        for (unsigned Index = 0; Index < BatchBundle->Inputs.size(); Index += 3) {
+          auto* Slot = dyn_cast<ConstantInt>(
+              BatchBundle->Inputs[Index].get());
+          Value* Step = BatchBundle->Inputs[Index + 1].get();
+          Value* Overflow = BatchBundle->Inputs[Index + 2].get();
+          if (!Slot || Slot->isZero() ||
+              Slot->getZExtValue() > deviceProfileCounterCount ||
+              !Step || !Step->getType()->isIntegerTy() ||
+              !Overflow || !Overflow->getType()->isIntegerTy(1)) {
+            errorMsg = "Metal device profile carrier has an invalid counter tuple";
+            return false;
+          }
+          Hits.push_back(ProfileHit{
+              Call, static_cast<uint32_t>(Slot->getZExtValue() - 1), Step,
+              Overflow});
+        }
+      }
+    }
+  }
+
+  if (Hits.empty()) {
+    return true;
+  }
+
+  auto& Ctx = M.getContext();
+  Type* I1 = Type::getInt1Ty(Ctx);
+  Type* I32 = Type::getInt32Ty(Ctx);
+  Type* I64 = Type::getInt64Ty(Ctx);
+  FunctionCallee Hook = M.getOrInsertFunction(
+      "__acpp_sscp_metal_profile_increment",
+      FunctionType::get(Type::getVoidTy(Ctx), {I32, I64, I1}, false));
+
+  for (const ProfileHit& Hit : Hits) {
+    IRBuilder<> Builder{Hit.carrier};
+    Value* Step = Builder.CreateZExtOrTrunc(Hit.step, I64);
+    Value* Overflow = Builder.CreateZExtOrTrunc(Hit.overflow, I1);
+    auto* ProfileCall = Builder.CreateCall(
+        Hook,
+        {ConstantInt::get(I32, Hit.slot), Step, Overflow});
+    ProfileCall->addFnAttr(Attribute::NoMerge);
+  }
+  for (CallBase* Carrier : Carriers) {
+    Carrier->eraseFromParent();
+  }
+  if (Function* Carrier = M.getFunction("llvm.donothing")) {
+    if (Carrier->use_empty()) {
+      Carrier->eraseFromParent();
+    }
+  }
+  return true;
+}
+
+bool MetalEmitter::analyzeDeviceProfileFunctions() {
+  deviceProfileFunctions.clear();
+  if (deviceProfileRecords.empty()) {
+    return true;
+  }
+
+  Function* Hook = M.getFunction("__acpp_sscp_metal_profile_increment");
+  if (!Hook || Hook->use_empty()) {
+    // Per-kernel JIT specialization can prove every instrumented path dead
+    // after target separation emitted the validated module-level records. In
+    // that case this code object has no device coverage contribution and must
+    // retain the ordinary, unprofiled Metal ABI. Malformed records have
+    // already been rejected by analyzeDeviceProfileMetadata().
+    deviceProfileRecords.clear();
+    deviceProfileCounterCount = 0;
+    return true;
+  }
+  for (User* U : Hook->users()) {
+    auto* Call = dyn_cast<CallBase>(U);
+    if (!Call || Call->getCalledOperand()->stripPointerCasts() != Hook ||
+        !Call->getFunction()) {
+      errorMsg = "Metal device profile increment hook has an unsupported use";
+      return false;
+    }
+    deviceProfileFunctions.insert(Call->getFunction());
+  }
+
+  bool Changed = true;
+  while (Changed) {
+    Changed = false;
+    for (Function& F : M) {
+      if (F.isDeclaration() || functionNeedsDeviceProfile(F)) {
+        continue;
+      }
+      for (BasicBlock& BB : F) {
+        for (Instruction& I : BB) {
+          auto* Call = dyn_cast<CallBase>(&I);
+          if (!Call) {
+            continue;
+          }
+          auto* Callee = dyn_cast<Function>(
+              Call->getCalledOperand()->stripPointerCasts());
+          if (Callee && functionNeedsDeviceProfile(*Callee)) {
+            Changed |= deviceProfileFunctions.insert(&F).second;
+            break;
+          }
+        }
+        if (functionNeedsDeviceProfile(F)) {
+          break;
+        }
+      }
+    }
+  }
+
+  for (const Function* F : deviceProfileFunctions) {
+    if (kernelNames.count(F->getName().str()) != 0) {
+      return true;
+    }
+  }
+  errorMsg = "Metal device profile counter hooks are not reachable from a kernel";
+  return false;
+}
