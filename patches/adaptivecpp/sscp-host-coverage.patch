+    if (line.compare(0, std::strlen(Record), Record) != 0) continue;
+    if (!header_seen) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: device profile record precedes header"});
+    }
+    uint64_t base = 0;
+    uint64_t count = 0;
+    uint64_t hash = 0;
+    std::string hex_name;
+    std::string trailing;
+    std::istringstream fields{line.substr(std::strlen(Record))};
+    if (!(fields >> base >> count >> hash >> hex_name) || (fields >> trailing) ||
+        base > UINT32_MAX || count == 0 || count > UINT32_MAX ||
+        base + count > UINT32_MAX) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: malformed device profile record"});
+    }
+    std::string name;
+    if (!decode_profile_name(hex_name, name)) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: invalid device profile record name"});
+    }
+    _device_profile_records.push_back(device_profile_record{
+        std::move(name), hash, static_cast<uint32_t>(count),
+        static_cast<uint32_t>(base)});
+  }
+
+  if (!header_seen) return make_success();
+  if (_device_profile_records.empty()) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile header has no records"});
+  }
+
+  uint64_t expected_base = 0;
+  std::set<std::pair<std::string, uint64_t>> unique_records;
+  for (const auto& record : _device_profile_records) {
+    if (record.base_counter != expected_base ||
+        !unique_records.emplace(record.name, record.hash).second) {
+      return make_error(__acpp_here(), error_info{
+          "metal_code_object: non-contiguous or duplicate device profile records"});
+    }
+    expected_base += record.num_counters;
+  }
+  if (expected_base != declared_counters) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile counter total mismatch"});
+  }
+  if (!_device) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: cannot allocate device profile buffer without a device"});
+  }
+
+  _device_profile_counter_count = static_cast<uint32_t>(declared_counters);
+  if (declared_counters >
+      (std::numeric_limits<std::size_t>::max() - 1) / 2) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile buffer slot count overflow"});
+  }
+  const std::size_t slots = static_cast<std::size_t>(declared_counters) * 2 + 1;
+  if (slots > std::numeric_limits<std::size_t>::max() / sizeof(uint32_t)) {
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile buffer size overflow"});
+  }
+  const std::size_t bytes = slots * sizeof(uint32_t);
+  _device_profile_buffer =
+      _device->newBuffer(bytes, MTL::ResourceStorageModeShared);
+  if (!_device_profile_buffer || !_device_profile_buffer->contents() ||
+      _device_profile_buffer->length() < bytes) {
+    if (_device_profile_buffer) {
+      _device_profile_buffer->release();
+      _device_profile_buffer = nullptr;
+    }
+    return make_error(__acpp_here(), error_info{
+        "metal_code_object: device profile buffer allocation failed"});
+  }
+  std::memset(_device_profile_buffer->contents(), 0, bytes);
+  return make_success();
+}
+
+void metal_sscp_executable_object::flush_device_profile() const {
+  const char* output_dir = std::getenv("ACPP_METAL_DEVICE_PROFILE_DIR");
+  if (!output_dir || output_dir[0] == '\0') return;
+  if (_device_profile_records.empty()) {
+    if (_device_profile_buffer) {
+      fail_device_profile_flush(
+          "profile buffer exists without device profile metadata");
+    }
+    return;
+  }
+  if (!_device_profile_buffer) {
+    fail_device_profile_flush("device profile metadata has no counter buffer");
+  }
+
+  const std::size_t logical_slots =
+      static_cast<std::size_t>(_device_profile_counter_count);
+  if (logical_slots > (std::numeric_limits<std::size_t>::max() - 1) / 2) {
+    fail_device_profile_flush("device profile buffer slot count overflow");
+  }
+  const std::size_t slots = logical_slots * 2 + 1;
+  const std::size_t bytes = slots * sizeof(uint32_t);
+  if (!_device_profile_buffer->contents() ||
+      _device_profile_buffer->length() < bytes) {
+    fail_device_profile_flush("invalid device profile counter buffer");
+  }
+
+  const auto* counters =
+      static_cast<const uint32_t*>(_device_profile_buffer->contents());
+  const std::size_t overflow_slot =
+      static_cast<std::size_t>(_device_profile_counter_count) * 2;
+  const bool overflow = counters[overflow_slot] != 0;
+  bool any_nonzero = false;
+  for (uint32_t i = 0; i < _device_profile_counter_count; ++i) {
+    const std::size_t low_slot = static_cast<std::size_t>(i) * 2;
+    any_nonzero |= counters[low_slot] != 0 || counters[low_slot + 1] != 0;
+  }
+  if (!any_nonzero && !overflow) return;
+
+  std::error_code ec;
+  std::filesystem::create_directories(output_dir, ec);
+  if (ec) {
+    fail_device_profile_flush(
+        std::string{"could not create device profile directory: "} +
+        ec.message());
+  }
+  if (!std::filesystem::is_directory(output_dir, ec) || ec) {
+    fail_device_profile_flush(
+        ec ? std::string{"could not inspect device profile directory: "} +
+                 ec.message()
+           : "device profile output path is not a directory");
+  }
+  const std::string stem =
+      std::string{"acpp-metal-device-"} + private_tmp_suffix() + "-" +
+      kernel_configuration::to_string(_id);
+
+  if (overflow) {
+    const std::string error_path =
+        common::filesystem::join_path(output_dir, stem + ".overflow");
+    write_device_profile_or_exit(
+        error_path,
+        "Metal device coverage counter overflow; profile rejected\n",
+        "device profile overflow marker");
+    HIPSYCL_DEBUG_WARNING
+        << "metal_code_object: device profile counter overflow; wrote "
+        << error_path << std::endl;
+    return;
+  }
+
+  std::ostringstream profile;
+  for (const auto& record : _device_profile_records) {
+    profile << record.name << "\n# Func Hash:\n" << record.hash
+            << "\n# Num Counters:\n" << record.num_counters
+            << "\n# Counter Values:\n";
+    for (uint32_t i = 0; i < record.num_counters; ++i) {
+      const std::size_t logical_slot =
+          static_cast<std::size_t>(record.base_counter) + i;
+      const std::size_t low_slot = logical_slot * 2;
+      const uint64_t value =
+          static_cast<uint64_t>(counters[low_slot]) |
+          (static_cast<uint64_t>(counters[low_slot + 1]) << 32);
+      profile << value << "\n";
+    }
+    profile << "\n";
+  }
+  const std::string profile_path =
+      common::filesystem::join_path(output_dir, stem + ".proftext");
+  write_device_profile_or_exit(profile_path, profile.str(),
+                               "device profile");
+  HIPSYCL_DEBUG_INFO
+      << "metal_code_object: wrote Metal device profile " << profile_path
+      << std::endl;
+}
